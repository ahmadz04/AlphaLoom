# Financial Datasets API Configuration
FINANCIAL_DATASETS_API_KEY=your_api_key_here
FINANCIAL_DATASETS_API_BASE=https://api.financialdatasets.ai

# OpenAI (chunk summarization)
OPENAI_API_KEY=your_openai_api_key_here

# Default settings
DEFAULT_TICKER=AAPL
DEFAULT_FILING_TYPE=10-K
NEWS_WINDOW_DAYS=7

# Legacy SeekingAlpha API (for transcript ingestion if needed)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=seeking-alpha21.p.rapidapi.com
RAPIDAPI_BASE=https://seeking-alpha21.p.rapidapi.com

# Storage: set to true to store all data in S3 instead of data/
USE_S3_STORAGE=false
AWS_S3_BUCKET=your_bucket_name
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
